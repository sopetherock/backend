datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Enums ---
enum AlertStatusType {
  SENT
  PROCESSED
}

enum ActionTakenType {
  STRIKE
  LATER
}

// --- User ---
model User {
  id             Int      @id @default(autoincrement())
  firebaseUid    String   @unique @map("firebase_uid")
  email          String   @unique
  username       String   @unique
  nickname       String   
  lightingPoints Int      @default(0) 
  createdAt      DateTime @default(now())
  level          Int      @default(1)
  fcmToken       String?

  // 1. 타이머 관계 (Todo -> PersonalTimer 통합)
  personalTimers PersonalTimer[]

  // 2. 그룹 관계
  groupMemberships GroupMembership[]

  // 3. 친구 관계
  requestedFriends Friend[] @relation("RequesterRelation")
  receivedFriends  Friend[] @relation("AddresseeRelation")
  
  // 4. 알림 관계 (에러 발생했던 부분 해결)
  notifications    Notification[]

  // 5. 실패 알림 관계
  failureAlertsSent     FriendFailureAlert[] @relation("FailedUser")
  failureAlertsReceived FriendFailureAlert[] @relation("NotifiedFriend")
}

// --- PersonalTimer (구 Todo) ---
model PersonalTimer {
  id        Int      @id @default(autoincrement())
  
  // 할일 내용 (단순 문자열)
  todo      String   
  
  duration  Int      
  startTime DateTime @default(now())
  endTime   DateTime?
  status    String   @default("running") 
  
  // User와의 관계
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   Int
  
  // 실패 알림 연결
  failureAlert FriendFailureAlert?
}

// --- FriendFailureAlert ---
model FriendFailureAlert {
  id                 Int      @id @default(autoincrement())
  
  failedUser         User     @relation("FailedUser", fields: [failedUserId], references: [id])
  failedUserId       Int
  
  notifiedFriend     User     @relation("NotifiedFriend", fields: [notifiedFriendId], references: [id])
  notifiedFriendId   Int
  
  // PersonalTimer와 연결
  failedTimer        PersonalTimer @relation(fields: [failedTimerId], references: [id])
  failedTimerId      Int           @unique 

  status             AlertStatusType    @default(SENT)
  actionTaken        ActionTakenType?
  createdAt          DateTime @default(now())
}

// --- Group ---
model Group {
  id           Int      @id @default(autoincrement())
  todo         String?   // 그룹 할일
  deadline     DateTime
  status       String   @default("ACTIVE")
  lastStrikeAt DateTime @default(now())
  members      GroupMembership[]
}

model GroupMembership {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  group        Group    @relation(fields: [groupId], references: [id])
  groupId      Int
  thunderCount Int      @default(0)
  status       String   @default("INVITED")
  
  @@unique([userId, groupId])
}

// --- Friend ---
model Friend {
  id          Int    @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      String @default("PENDING")

  requester User @relation("RequesterRelation", fields: [requesterId], references: [id])
  addressee User @relation("AddresseeRelation", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

// --- Notification (에러 해결 핵심) ---
model Notification {
  id        Int      @id @default(autoincrement())
  
  // [중요] User 모델의 notifications[] 와 짝이 되는 부분입니다.
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      
  
  type      String   
  message   String
  isRead    Boolean  @default(false)
  relatedId Int?     
  createdAt DateTime @default(now())
}